# Copy to `.env.production` in the repo root on the server and fill it in. Never commit the real file.
# docker compose -f compose.prod.yaml --env-file .env.production up -d --build

# Public host. Its DNS record must point at the server before the first start (see docs/deploy.md).
DOMAIN=bordo.thiagowilliam.com.br

# Generate with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=change-me

# Account e-mails (password recovery, change of e-mail). Any SMTP provider with a verified domain.
#   Resend: smtps://resend:API_KEY@smtp.resend.com:465
MAIL_SMTP_URL=
MAIL_FROM="Bordo <nao-responda@thiagowilliam.com.br>"

# Google sign-in (optional). Authorize https://<DOMAIN>/api/auth/google/callback in the Google Cloud Console (docs/deploy.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
