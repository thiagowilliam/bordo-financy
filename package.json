{
  "name": "bordo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @bordo/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "storybook": "pnpm --filter @bordo/web storybook",
    "prepare": "husky",
    "dev:api": "pnpm --filter @bordo/api dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9"
  }
}
