# Address of the API. `/api/*` is proxied to it, so the session cookie is first-party.
# Optional in development (defaults to the local API), required in production.
BACKEND_URL=http://localhost:3001

# Development only: answer `/api/*` with the MSW mocks instead of the API, to work on screens
# without it. Anything but "enabled" uses the real API.
# NEXT_PUBLIC_API_MOCKING=enabled
