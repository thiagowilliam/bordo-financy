NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# Optional in development (falls back to in-memory rate limiting), required in production.
# Uncomment after `docker compose up -d redis` to test the shared rate limit storage.
# REDIS_URL=redis://localhost:6379

# Postgres. Optional in development and tests, required in production.
# `docker compose up -d postgres`, then `pnpm --filter @bordo/api db:migrate`.
# DATABASE_URL=postgres://bordo:bordo@localhost:5432/bordo
DATABASE_POOL_MAX=10

# Where uploaded photos go. `local` is a folder on disk (relative to where the API starts).
# Use a volume in containers; an S3 compatible driver (AWS S3, Cloudflare R2) replaces it in the cloud.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# Prefix of the photo URLs the API returns: the media route by default, the bucket or CDN address later.
MEDIA_BASE_URL=/api/media

# Account e-mails (password recovery, change of e-mail), sent through a BullMQ queue on Redis.
# Development: `docker compose up -d mailpit redis`, then read them at http://localhost:8025.
# Without MAIL_SMTP_URL the e-mails are only printed in the API log.
# MAIL_SMTP_URL=smtp://localhost:1025
# MAIL_FROM="Bordo <nao-responda@bordo.local>"
# Production (both required): any SMTP provider, with a domain verified there. Examples:
#   Resend:    smtps://resend:API_KEY@smtp.resend.com:465
#   Amazon SES: smtps://SMTP_USER:SMTP_PASSWORD@email-smtp.<region>.amazonaws.com:465
# MAIL_FROM="Bordo <nao-responda@seudominio.com>"

# Public address of the web app, used in the links of e-mails (password recovery).
WEB_URL=http://localhost:3000

# Google sign-in (Google Cloud Console > Credentials > OAuth client ID > Web application). All three or none.
# Authorized redirect URI: the same GOOGLE_REDIRECT_URI, on the web app's address (the web proxies /api to this API).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Addresses or CIDR ranges of the proxies in front of the API, comma separated.
# Never a number: Fastify trusts no proxy at all for a hop count.
# Empty means no proxy is trusted (client IP is the socket address).
TRUST_PROXY=

# Global rate limit per client IP. Route limits are stricter and live in the code.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
