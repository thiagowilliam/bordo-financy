NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# Optional in development (falls back to in-memory rate limiting), required in production.
# Uncomment after `docker compose up -d redis` to test the shared rate limit storage.
# REDIS_URL=redis://localhost:6379

# Addresses or CIDR ranges of the proxies in front of the API, comma separated.
# Never a number: Fastify trusts no proxy at all for a hop count.
# Empty means no proxy is trusted (client IP is the socket address).
TRUST_PROXY=

# Global rate limit per client IP. Route limits are stricter and live in the code.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
